---
import BaseLayout from '~/layouts/BaseLayout.astro';
import TrustBar from '~/components/sections/TrustBar.astro';
import FinalCTA from '~/components/sections/FinalCTA.astro';
import Reveal from '~/components/animations/Reveal.tsx';
import Breadcrumb from '~/components/ui/Breadcrumb.astro';
import { CITIES } from '~/lib/cities';
import { SERVICES } from '~/lib/services';
import { localBusinessJsonLd, faqJsonLd, breadcrumbJsonLd } from '~/lib/seo';

export function getStaticPaths() {
  return CITIES.map((city) => ({
    params: { city: city.slug },
    props: { city },
  }));
}

const { city } = Astro.props;

const cityFaqs = [
  {
    q: `Wie viel kostet ein Immobiliengutachten in ${city.name}?`,
    a: `Die Kosten für ein Verkehrswertgutachten in ${city.name} beginnen je nach Objekttyp und Größe ab 1.299 € und reichen bis 3.499 €. Sie erhalten vor Auftragserteilung immer ein verbindliches Festpreisangebot — keine versteckten Kosten, keine Nachforderungen.`,
  },
  {
    q: `Ist der Gutachter auch persönlich in ${city.name} vor Ort?`,
    a: `Ja — Erdem Tanrikulu ist als DEKRA-zertifizierter Sachverständiger persönlich in ${city.name} tätig (${city.distanceFromDuesseldorf}). Ein Vor-Ort-Termin ist problemlos möglich, die Anfahrt ist im Festpreis enthalten.`,
  },
  {
    q: `Werden Gutachten aus ${city.name} vom Finanzamt anerkannt?`,
    a: `Ja. Unsere Verkehrswertgutachten nach § 194 BauGB werden bundesweit von Finanzämtern anerkannt — unabhängig davon, ob das Objekt in ${city.name} oder einer anderen Stadt liegt. Als DEKRA-zertifizierter Sachverständiger erfüllen wir alle formalen Anforderungen.`,
  },
  {
    q: `Wie schnell erhalte ich ein Gutachten für eine Immobilie in ${city.name}?`,
    a: `Nach Ortstermin und Eingang aller Unterlagen liefern wir das fertige Gutachten in der Regel innerhalb von 7–14 Werktagen. Bei dringenden Fällen in ${city.name} bieten wir auf Anfrage eine Expressbearbeitung an.`,
  },
  {
    q: `Für welche Immobilientypen erstellen Sie Gutachten in ${city.name}?`,
    a: `Wir bewerten alle gängigen Immobilientypen in ${city.name}: Einfamilienhäuser, Doppelhäuser, Eigentumswohnungen, Mehrfamilienhäuser, Wohn- und Geschäftshäuser sowie unbebaute Grundstücke. Auch Sonderobjekte wie Denkmalimmobilien oder Erbbaurechtsgrundstücke bewerten wir.`,
  },
];

const breadcrumbItems = [
  { name: 'Start', href: '/' },
  { name: 'Vor Ort', href: '/einzugsgebiet' },
  { name: city.name, href: `/immobiliengutachter-${city.slug}` },
];

---
<BaseLayout
  title={`Immobiliengutachter ${city.name} — DEKRA-zertifiziert`}
  description={`DEKRA-zertifizierter Immobiliengutachter in ${city.name} — Verkehrswertgutachten, Immobilienbewertung und Kaufberatung. Festpreis, schnell, bundesweit anerkannt. Erste Einschätzung kostenlos.`}
  jsonLd={[
    localBusinessJsonLd(),
    faqJsonLd(cityFaqs),
    breadcrumbJsonLd([
      { name: 'Start', url: '/' },
      { name: 'Einzugsgebiet', url: '/einzugsgebiet' },
      { name: `Gutachter ${city.name}`, url: `/immobiliengutachter-${city.slug}` },
    ]),
  ]}
>

  {/* ── Hero ── */}
  <section class="section-y bg-cream">
    <div class="container-x">
      <Breadcrumb items={breadcrumbItems} />
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <p class="eyebrow">Immobiliengutachter {city.name}</p>
          <h1 class="display-1 mt-6">
            DEKRA-zertifizierter<br/>
            Gutachter in<br/>
            <span class="italic text-green">{city.name}.</span>
          </h1>
          <p class="mt-8 text-xl leading-relaxed" style="color: var(--color-mute)">
            {city.intro}
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <button
              onclick="window.dispatchEvent(new CustomEvent('open-consultation-modal'))"
              class="btn-primary"
            >
              Kostenlose Erstanfrage
            </button>
            <a href="/online-bewertung" class="link-underline text-sm font-medium">
              Online-Bewertung starten →
            </a>
          </div>
          <div class="mt-8 flex flex-wrap gap-2">
            {city.dominantPropertyTypes.map(t => (
              <span class="rounded-full border border-line px-3 py-1 text-xs font-medium" style="color: var(--color-mute)">{t}</span>
            ))}
            <span class="rounded-full border border-line px-3 py-1 text-xs font-medium" style="color: var(--color-mute)">{city.region}</span>
          </div>
        </div>

        <Reveal client:visible>
          <div class="rounded-2xl border border-line bg-paper p-8 space-y-5">
            <p class="eyebrow text-xs">Marktmerkmale {city.name}</p>
            {city.characteristics.map((c) => (
              <div class="flex gap-3 border-t border-line pt-5">
                <svg class="mt-0.5 shrink-0 text-green" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <p class="text-sm leading-relaxed" style="color: var(--color-mute)">{c}</p>
              </div>
            ))}
          </div>
        </Reveal>
      </div>
    </div>
  </section>

  <TrustBar />

  {/* ── Leistungen ── */}
  <section class="section-y bg-paper">
    <div class="container-x">
      <Reveal client:visible>
        <div class="max-w-xl">
          <p class="eyebrow">Unsere Leistungen in {city.name}</p>
          <h2 class="display-2 mt-4">
            Alle Gutachtenarten —<br/>
            <span class="italic text-green">aus einer Hand.</span>
          </h2>
        </div>
      </Reveal>
      <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {SERVICES.map((s, i) => (
          <Reveal client:visible delay={i * 0.04}>
            <a href={`/leistungen/${s.slug}`} class="card flex h-full flex-col gap-3 transition-colors hover:border-green">
              <h3 class="font-display text-lg">{s.title}</h3>
              <p class="flex-1 text-sm leading-relaxed" style="color: var(--color-mute)">{s.short}</p>
              <span class="text-sm font-medium text-green">Mehr erfahren →</span>
            </a>
          </Reveal>
        ))}
      </div>
    </div>
  </section>

  {/* ── Standorte ── */}
  <section class="section-y bg-cream">
    <div class="container-x max-w-3xl">
      <p class="eyebrow">Weitere Standorte</p>
      <p class="mt-4 text-lg leading-relaxed" style="color: var(--color-mute)">
        Unser Büro liegt in Düsseldorf – mehr zum <a href="/" class="link-underline">Immobiliengutachter in Düsseldorf</a>. Außerdem vor Ort in{' '}
        {CITIES.filter((c) => c.slug !== city.slug).map((c, i, arr) => (<>{i > 0 && (i === arr.length - 1 ? ' und ' : ', ')}<a href={`/immobiliengutachter-${c.slug}`} class="link-underline">{c.name}</a></>))}.
      </p>
    </div>
  </section>

  {/* ── Stadt-FAQ ── */}
  <section class="section-y bg-paper">
    <div class="container-x max-w-3xl">
      <Reveal client:visible>
        <p class="eyebrow">Häufige Fragen</p>
        <h2 class="display-2 mt-4">
          Gutachter in {city.name} —<br/>
          <span class="italic text-green">Ihre Fragen.</span>
        </h2>
      </Reveal>
      <div class="mt-10">
        {cityFaqs.map((faq, i) => (
          <Reveal client:visible delay={i * 0.05}>
            <div class="border-t border-line py-6">
              <h3 class="font-display text-lg">{faq.q}</h3>
              <p class="mt-3 text-sm leading-relaxed" style="color: var(--color-mute)">{faq.a}</p>
            </div>
          </Reveal>
        ))}
        <div class="border-t border-line pt-6">
          <a href="/faq" class="text-sm text-green hover:underline">Alle Fragen & Antworten →</a>
        </div>
      </div>
    </div>
  </section>

  <FinalCTA />
</BaseLayout>
